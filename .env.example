# Copy this file to .env. Never commit the real .env file.
# SQL Server requires a strong password (upper/lowercase, digit and symbol).
MSSQL_SA_PASSWORD=ChangeThis_StrongPassword123!

# At least 32 random characters. Generate one with: openssl rand -base64 48
JWT_KEY=change-this-to-a-long-random-production-secret-at-least-32-characters
JWT_ISSUER=RestoreAPI
JWT_AUDIENCE=RestoreClient

# Public URL has no trailing slash. For local Docker: http://localhost
PUBLIC_ORIGIN=http://localhost

# On EC2 behind Caddy, use 127.0.0.1 and port 8080.
# For direct local access, keep 0.0.0.0 and port 80.
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80

# Optional integrations. Fill these before using their related features.
SEPAY_BANK_ACCOUNT_NUMBER=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_HOLDER=
SEPAY_WEBHOOK_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=Restore System
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=true

# Kibana is bound to localhost and only starts with the observability profile.
KIBANA_PORT=5601
